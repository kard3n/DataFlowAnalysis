<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="datadictionary" nsURI="http://dataflowanalysis.org/dfd/datadictionary"
    nsPrefix="datadictionary">
  <eClassifiers xsi:type="ecore:EClass" name="DataDictionary" eSuperTypes="platform:/plugin/tools.mdsd.modelingfoundations.identifier/model/identifier.ecore#//Entity">
    <eStructuralFeatures xsi:type="ecore:EReference" name="labelTypes" upperBound="-1"
        eType="#//BasicLabelType" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="behavior" upperBound="-1"
        eType="#//Behavior" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="consentlabeltype" upperBound="-1"
        eType="#//ConsentLabelType" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rolelabeltype" upperBound="-1"
        eType="#//RoleLabelType" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Behavior" eSuperTypes="platform:/plugin/tools.mdsd.modelingfoundations.identifier/model/identifier.ecore#//Entity">
    <eStructuralFeatures xsi:type="ecore:EReference" name="inPin" upperBound="-1"
        eType="#//Pin" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="outPin" upperBound="-1"
        eType="#//Pin" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="assignment" upperBound="-1"
        eType="#//AbstractAssignment" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Pin" eSuperTypes="platform:/plugin/tools.mdsd.modelingfoundations.identifier/model/identifier.ecore#//Entity"/>
  <eClassifiers xsi:type="ecore:EClass" name="AbstractAssignment" abstract="true"
      eSuperTypes="platform:/plugin/tools.mdsd.modelingfoundations.identifier/model/identifier.ecore#//Entity">
    <eStructuralFeatures xsi:type="ecore:EReference" name="outputPin" lowerBound="1"
        eType="#//Pin"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Assignment" eSuperTypes="#//AbstractAssignment">
    <eStructuralFeatures xsi:type="ecore:EReference" name="term" lowerBound="1" eType="#//Term"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="outputLabels" upperBound="-1"
        eType="#//Label"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="inputPins" upperBound="-1"
        eType="#//Pin"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ForwardingAssignment" eSuperTypes="#//AbstractAssignment">
    <eStructuralFeatures xsi:type="ecore:EReference" name="inputPins" upperBound="-1"
        eType="#//Pin"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Label" abstract="true" eSuperTypes="platform:/plugin/tools.mdsd.modelingfoundations.identifier/model/identifier.ecore#//Entity"/>
  <eClassifiers xsi:type="ecore:EClass" name="LabelType" abstract="true" eSuperTypes="platform:/plugin/tools.mdsd.modelingfoundations.identifier/model/identifier.ecore#//Entity"/>
  <eClassifiers xsi:type="ecore:EClass" name="Term" abstract="true" eSuperTypes="platform:/plugin/tools.mdsd.modelingfoundations.identifier/model/identifier.ecore#//Entity"/>
  <eClassifiers xsi:type="ecore:EClass" name="TRUE" eSuperTypes="#//Term"/>
  <eClassifiers xsi:type="ecore:EClass" name="BinaryOperator" abstract="true" eSuperTypes="#//Term">
    <eStructuralFeatures xsi:type="ecore:EReference" name="terms" lowerBound="2" upperBound="2"
        eType="#//Term" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AND" eSuperTypes="#//BinaryOperator"/>
  <eClassifiers xsi:type="ecore:EClass" name="OR" eSuperTypes="#//BinaryOperator"/>
  <eClassifiers xsi:type="ecore:EClass" name="NOT" eSuperTypes="#//Term">
    <eStructuralFeatures xsi:type="ecore:EReference" name="negatedTerm" lowerBound="1"
        eType="#//Term" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="LabelReference" eSuperTypes="#//Term">
    <eStructuralFeatures xsi:type="ecore:EReference" name="label" lowerBound="1" eType="#//Label"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SetAssignment" eSuperTypes="#//AbstractAssignment">
    <eStructuralFeatures xsi:type="ecore:EReference" name="outputLabels" upperBound="-1"
        eType="#//Label"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="UnsetAssignment" eSuperTypes="#//AbstractAssignment">
    <eStructuralFeatures xsi:type="ecore:EReference" name="outputLabels" upperBound="-1"
        eType="#//Label"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ConsentLabel" eSuperTypes="#//Label">
    <eStructuralFeatures xsi:type="ecore:EReference" name="consent" lowerBound="1"
        eType="ecore:EClass ../../org.dataflowanalysis.privacy.consent_model/model/consent_model.ecore#//ConsentedFunctionality"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="BasicLabel" eSuperTypes="#//Label"/>
  <eClassifiers xsi:type="ecore:EClass" name="RoleLabel" eSuperTypes="#//Label">
    <eStructuralFeatures xsi:type="ecore:EReference" name="role" lowerBound="1" eType="ecore:EClass ../../org.dataflowanalysis.privacy.consent_model/model/consent_model.ecore#//Role"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="BasicLabelType" eSuperTypes="#//LabelType">
    <eStructuralFeatures xsi:type="ecore:EReference" name="basiclabel" upperBound="-1"
        eType="#//BasicLabel" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ConsentLabelType" eSuperTypes="#//LabelType">
    <eStructuralFeatures xsi:type="ecore:EReference" name="consentlabel" eType="#//ConsentLabel"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RoleLabelType" eSuperTypes="#//LabelType">
    <eStructuralFeatures xsi:type="ecore:EReference" name="rolelabel" eType="#//RoleLabel"/>
  </eClassifiers>
</ecore:EPackage>
